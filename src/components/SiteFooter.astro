---
import Logo from './Logo.astro';
import { site } from '~/config/site';

const legal = [
  { href: site.termsUrl, label: 'Termini di utilizzo' },
  { href: site.privacyUrl, label: 'Privacy policy' },
  { href: site.cookieUrl, label: 'Cookie policy' },
].filter((link) => link.href.trim());

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="rule" aria-hidden="true"></div>
    <div class="footer-grid">
      <a class="footer-brand" href="#top" aria-label="Discerns, torna all’inizio">
        <Logo />
      </a>

      <div class="footer-col">
        <p class="footer-label">Azienda</p>
        <address class="footer-company">
          <span>{site.companyName}</span>
          <span>P.IVA {site.vatNumber}</span>
          <span>{site.companyAddress}</span>
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </address>
      </div>

      {
        legal.length > 0 && (
          <nav class="footer-col" aria-label="Note legali">
            <p class="footer-label">Legale</p>
            <ul class="footer-legal">
              {legal.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
    <p class="footer-copy">© {year} {site.companyName}</p>
  </div>
</footer>
