---
import Logo from './Logo.astro';
import WhatsAppCta from './WhatsAppCta.astro';

const links = [
  { href: '#intervista', label: 'L’intervista' },
  { href: '#come-funziona', label: 'Come funziona' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="site-brand" href="#top" aria-label="Discerns, torna all’inizio">
      <Logo />
    </a>
    <nav class="site-nav" aria-label="Navigazione principale">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <WhatsAppCta class="header-cta" />
  </div>
</header>
