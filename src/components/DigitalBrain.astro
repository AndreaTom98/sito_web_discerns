---
// Il cervello digitale è il motivo per cui i post suonano come il cliente, e
// la cosa che resta sua. Un unico riquadro distintivo, stessa posizione.
const collected = ['Esperienze', 'Metodo', 'Punti di vista'];
---

<section class="wrap brain-wrap" aria-label="Cervello digitale">
  <div class="brain-card reveal">
    <div class="brain-main">
      <span class="tag tag-accent brain-tag">Incluso</span>
      <h2 class="brain-title">Il tuo cervello digitale. Cresce ogni mese, e resta tuo.</h2>
      <p class="dim">
        Ogni intervista aggiunge esperienze, metodo e punti di vista al tuo cervello digitale. È il
        motivo per cui i post suonano come te dalla prima settimana, e migliorano nel tempo.
      </p>
      <p class="dim">
        È tuo. Se un giorno smetti, resta a te. Puoi collegarlo al tuo ChatGPT o Claude e usarlo per
        altri contenuti.
      </p>
      <p class="strong">Non devi usarlo. Ma è tuo.</p>
    </div>

    <!-- Raccogli → riusa: le voci si accumulano, la richiesta le riutilizza. -->
    <div class="brain-demo">
      <span class="kicker">Dopo ogni intervista</span>
      <ul class="brain-notes">
        {
          collected.map((item) => (
            <li>
              <span class="note-dash" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
      <svg
        class="brain-flow"
        width="16"
        height="34"
        viewBox="0 0 16 34"
        fill="none"
        aria-hidden="true"
      >
        <path
          class="arrow-path"
          d="M8 1v27M2 24l6 7 6-7"
          stroke="var(--color-accent)"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="kicker">Un esempio di richiesta</span>
      <div class="brain-quote">“Scrivi un post su come gestisco le obiezioni dei clienti”</div>
    </div>
  </div>
</section>
