---
const steps = [
  {
    n: '01',
    title: 'Un’ora insieme, ogni mese.',
    body: 'Non un questionario: una conversazione vera in videocall, guidata da noi. Ci racconti il tuo lavoro, ti facciamo domande e approfondiamo esperienze, scelte e idee che vale la pena condividere. Non devi preparare niente.',
  },
  {
    n: '02',
    title: 'Tre post pronti, ogni settimana.',
    body: 'Trasformiamo quello che emerge in contenuti con il tuo modo di esprimerti, pensati per le persone che vuoi raggiungere. Tre a settimana è il ritmo che regge nel tempo senza diventare rumore.',
  },
  {
    n: '03',
    title: 'Li rileggiamo noi, li approvi tu, poi escono.',
    body: 'Ogni post passa da due persone prima di uscire: noi e te. Tu li leggi, ci segnali eventuali modifiche e li approvi. Noi li programmiamo e li pubblichiamo.',
  },
];
---

<section id="come-funziona" class="wrap how" aria-label="Come funziona">
  <h2>Tu parli e approvi. Noi scriviamo e pubblichiamo.</h2>
  <ol class="steps">
    {
      steps.map((step, i) => (
        <li class="step-row">
          {i > 0 && <div class="rule-top" aria-hidden="true" />}
          <p class="step-num">{step.n}</p>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
